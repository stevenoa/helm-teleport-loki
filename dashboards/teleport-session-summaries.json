            "datasource": { "type": "loki", "uid": "afqc1lplux9fka" },
            "expr": "sum(count_over_time({job=\"teleport-audit\"} | json | event=\"session.summarized\" | risk_level=\"HIGH\" [$__range]))",
            "queryType": "instant",
            "refId": "A"
