          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["sum"] }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": {
              "steps": [
                { "color": "green", "value": null },
