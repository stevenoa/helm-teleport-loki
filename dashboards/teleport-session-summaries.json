{
  "dashboard": {
    "title": "Teleport — Session Summaries",
    "tags": [
      "teleport",
      "session-summaries",
      "audit",
      "identity-security",
      "risk"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "panels": [
      {
        "id": 1,
        "title": "Total Summaries (24h)",
        "type": "stat",
        "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
        "datasource": { "type": "loki", "uid": "afqc1lplux9fka" },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "reduceOptions": { "calcs": ["sum"] }
        },
        "fieldConfig": {
          "defaults": {
            "color": { "mode": "thresholds" },
            "thresholds": { "steps": [ { "color": "blue", "value": null } ] }
          }
        },
        "targets": [
          {
            "datasource": { "type": "loki", "uid": "afqc1lplux9fka" },
            "expr": "sum(count_over_time({job=\"teleport-audit\"} | json | event=\"session.summarized\" [$__range]))",
            "queryType": "instant",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "High Risk (24h)",
        "type": "stat",
